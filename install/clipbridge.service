[Unit]
Description=ClipBridge Clipboard Sync
After=network.target graphical.target
Wants=graphical.target

[Service]
Type=simple
Environment=DISPLAY=:0
# Placeholder expanded by install/linux_setup.sh, or edit manually after `pip install --user`.
# Example: ExecStart=/home/you/.local/bin/clipbridge client
# Add User=youruser below when installing as a system unit under /etc/systemd/system/.
ExecStart=CLIPBRIDGE_EXEC client
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
